# Server-only secret. Never prefix secrets with NEXT_PUBLIC_.
GEMINI_API_KEY=replace-with-a-server-side-Gemini-key

# SHA-256 hex digest of the complete jv_<43-char-base64url> device token.
# Generate a fresh token and its digest using the README instructions.
JARVIS_DEVICE_TOKEN_SHA256=replace-with-64-character-sha256-hex
